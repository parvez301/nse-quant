# AWS profile + region for this project. Override via `.envrc.local` (gitignored)
# or by exporting them in your shell before `cd`-ing in. Auto-loads via direnv
# (`brew install direnv`); if you don't use direnv, run: `source ./activate.sh`
export AWS_PROFILE=${AWS_PROFILE:-default}
unset AWS_DEFAULT_PROFILE
export AWS_REGION=${AWS_REGION:-ap-south-1}
export AWS_DEFAULT_REGION=${AWS_REGION}

# Per-machine overrides — keep secrets / personal config out of git
[[ -f .envrc.local ]] && source_env .envrc.local
